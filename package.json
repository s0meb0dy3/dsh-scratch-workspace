{
  "name": "@s0meb0dy3/dsh-scratch-workspace",
  "version": "1.6.3",
  "type": "module",
  "description": "Temporary DSH workspaces: one-click creation, a management panel with idle countdown and folder size, and safe cleanup with optional idle auto-expiry.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "workspace",
    "scratch",
    "temporary",
    "cleanup"
  ],
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "build.lock.json",
    "index.js",
    "service.js",
    "core.js",
    "activity.js",
    "user-api.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "test": "node --test *.test.js",
    "prepublishOnly": "node build.mjs --check && node --test *.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0meb0dy3/dsh-scratch-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/s0meb0dy3/dsh-scratch-workspace/issues"
  },
  "homepage": "https://github.com/s0meb0dy3/dsh-scratch-workspace#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
